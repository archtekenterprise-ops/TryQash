# TryQash frontend - environment variables.
# Copy this file to ".env.local" and fill in the values for your environment.
# Credential files (.env, .env.local, .env.*) are ignored by git - see .gitignore.

# ---------------------------------------------------------------------------
# Supabase (planned backend integration - not connected yet)
# ---------------------------------------------------------------------------
# Both values are public and safe to expose to the browser. Find them in your
# Supabase dashboard under: Project Settings -> API.

# Your Supabase project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The project's publishable API key (sb_publishable_...).
# If your project still uses legacy API keys, set the anon public key as
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead - it is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER put a service-role key (or any other secret) in a NEXT_PUBLIC_*
# variable or anywhere in browser-side code.

# ---------------------------------------------------------------------------
# Server-side Supabase (Backend Only)
# ---------------------------------------------------------------------------
# The service role key provides full access - use ONLY in server-side code
# (API routes, server components, backend functions). NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Provider Secrets (for postback verification)
# ---------------------------------------------------------------------------
# These secrets are used to verify provider postback signatures.
# Get these from your provider dashboards when you integrate them.

# CPX Research
CPX_SECRET=

# AdGem
ADGEM_SECRET=

# Awin
AWIN_SECRET=

# ---------------------------------------------------------------------------
# Scaffold infrastructure - platform health check only
# ---------------------------------------------------------------------------
# Used exclusively by the scaffold-provided src/db client and the
# /api/health route. Not part of the TryQash frontend feature set.
DATABASE_URL=postgresql://user:password@host:5432/database
